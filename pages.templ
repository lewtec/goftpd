package goftpd

type listingLabels struct {
	Name     string
	Size     string
	Modified string
}

templ layout(title, lang string) {
	<!DOCTYPE html>
	<html lang={ lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/__goftpd__/sakura.css" media="screen"/>
			<link rel="stylesheet" href="/__goftpd__/sakura-dark.css" media="screen and (prefers-color-scheme: dark)"/>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ listingPage(title, lang string, labels listingLabels, crumbs []crumb, parent string, entries []listEntry) {
	@layout(title, lang) {
		<h1>{ title }</h1>
		<nav>
			for i, c := range crumbs {
				if i > 0 {
					{ " / " }
				}<a href={ templ.SafeURL(c.Href) }>{ c.Name }</a>
			}
		</nav>
		<table>
			<thead>
				<tr>
					<th>{ labels.Name }</th>
					<th nowrap>{ labels.Size }</th>
					<th nowrap>{ labels.Modified }</th>
				</tr>
			</thead>
			<tbody>
				if parent != "" {
					<tr>
						<td><a href={ templ.SafeURL(parent) }>..</a></td>
						<td nowrap></td>
						<td nowrap></td>
					</tr>
				}
				for _, e := range entries {
					<tr>
						<td><a href={ templ.SafeURL(e.Href) }>{ e.Name }</a></td>
						<td nowrap>{ e.Size }</td>
						<td nowrap>{ e.Mtime }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ notFoundPage(lang, title, lead, reqPath, back string) {
	@layout(title, lang) {
		<h1>{ title }</h1>
		<p>{ lead } <code>{ reqPath }</code>.</p>
		<p><a href="/">{ back }</a></p>
	}
}
